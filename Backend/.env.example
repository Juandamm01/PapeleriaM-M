DATABASE_URL="postgresql://papeleria:papeleria@db:5432/papeleria_mm?schema=public"
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-example-password
JWT_SECRET=replace-with-a-long-random-secret
# Varias URLs separadas por comas si hace falta (ej. dominio propio y vercel.app)
FRONTEND_URL=http://localhost:5173
NODE_ENV=development
# Número de proxies delante de la API en producción (Railway/Render: 1). 0 en local.
TRUST_PROXY=0
# Días que se guardan los archivos después de entregar el pedido, y máximo desde que se creó
RETENCION_DIAS_ENTREGADO=7
RETENCION_DIAS_MAXIMO=30
