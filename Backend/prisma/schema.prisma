generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Pedido {
  id                   String        @id @default(uuid())
  codigo               String        @unique
  nombre               String
  correo               String
  telefono             String?
  notas                String?
  archivoNombre        String
  archivoRuta          String
  tipoArchivo          String
  copias               Int           @default(1)
  tamano               TamanoPapel   @default(CARTA)
  tipoImpresion        TipoImpresion @default(BN)
  dobleCara            Boolean       @default(false)
  metodoPago           MetodoPago
  referenciaNequi      String?
  comprobanteNombre    String?
  comprobanteRuta      String?
  comprobanteTipo      String?
  estado               EstadoPedido  @default(PENDIENTE)
  /// Momento en que el cliente aceptó la política de tratamiento de datos (Ley 1581)
  consentimientoAt     DateTime?
  /// Se fija al pasar a ENTREGADO; cuenta los días de retención de los archivos
  entregadoAt          DateTime?
  /// Cuándo se borraron del disco el archivo y el comprobante por retención
  archivosEliminadosAt DateTime?
  /// Valor a cobrar en centavos de COP; lo fija el admin al revisar el archivo
  precioCentavos       Int?
  estadoPago           EstadoPago    @default(PENDIENTE)
  pagadoAt             DateTime?
  /// true si el admin confirmó el pago a mano (efectivo o transferencia verificada)
  pagoManual           Boolean       @default(false)
  pagos                Pago[]
  createdAt            DateTime      @default(now())

  @@index([estado, createdAt])
  @@index([estadoPago, createdAt])
  @@index([archivosEliminadosAt, createdAt])
}

model Admin {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

enum MetodoPago {
  NEQUI
  EFECTIVO
}

enum EstadoPedido {
  PENDIENTE
  LISTO
  ENTREGADO
}

enum TamanoPapel {
  CARTA
  OFICIO
}

enum TipoImpresion {
  BN
  COLOR
}

/// Un intento de cobro con Nequi a través de Wompi. Un pedido puede tener varios intentos.
model Pago {
  id                 String     @id @default(uuid())
  pedidoId           String
  pedido             Pedido     @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  /// Referencia única enviada a Wompi: <codigo>-<n-intento>
  referencia         String     @unique
  montoCentavos      Int
  estado             EstadoPago @default(PENDIENTE)
  wompiTransactionId String?    @unique
  /// Últimos 4 dígitos del celular Nequi (no se guarda el número completo)
  telefonoFinal      String
  motivo             String?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  @@index([pedidoId, createdAt])
  @@index([estado, updatedAt])
}

enum EstadoPago {
  PENDIENTE
  APROBADO
  RECHAZADO
  EXPIRADO
  ANULADO
}
