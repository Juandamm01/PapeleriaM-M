generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Pedido {
  id            String      @id @default(uuid())
  nombre        String
  correo        String
  telefono      String?
  notas         String?
  archivoNombre String
  archivoRuta   String
  tipoArchivo   String
  metodoPago    MetodoPago
  estado        EstadoPedido @default(PENDIENTE)
  createdAt     DateTime    @default(now())
}

model Admin {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

enum MetodoPago {
  NEQUI
  EFECTIVO
}

enum EstadoPedido {
  PENDIENTE
  LISTO
  ENTREGADO
}
