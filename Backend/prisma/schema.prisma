generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Pedido {
  id                String        @id @default(uuid())
  codigo            String        @unique
  nombre            String
  correo            String
  telefono          String?
  notas             String?
  archivoNombre     String
  archivoRuta       String
  tipoArchivo       String
  copias            Int           @default(1)
  tamano            TamanoPapel   @default(CARTA)
  tipoImpresion     TipoImpresion @default(BN)
  dobleCara         Boolean       @default(false)
  metodoPago        MetodoPago
  referenciaNequi   String?
  comprobanteNombre String?
  comprobanteRuta   String?
  comprobanteTipo   String?
  estado            EstadoPedido  @default(PENDIENTE)
  createdAt         DateTime      @default(now())

  @@index([estado, createdAt])
}

model Admin {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

enum MetodoPago {
  NEQUI
  EFECTIVO
}

enum EstadoPedido {
  PENDIENTE
  LISTO
  ENTREGADO
}

enum TamanoPapel {
  CARTA
  OFICIO
}

enum TipoImpresion {
  BN
  COLOR
}
